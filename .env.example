# Ranchi Pathology — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Environment ───
ENVIRONMENT=demo                    # "demo" or "production"

# ─── Cloudflare D1 ───
D1_DATABASE_ID=your_d1_database_id

# ─── Cloudflare R2 ───
R2_BUCKET_NAME=ranchi-pathology-reports

# ─── Admin Authentication ───
ADMIN_JWT_SECRET=generate_a_strong_random_string_here

# ─── UPI Payment Configuration ───
DEFAULT_UPI_ID=6204522977@ptyes
DEFAULT_UPI_PAYEE=sanu

# ─── WhatsApp Business Cloud API ───
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_APP_SECRET=your_app_secret

# ─── Meta Graph API ───
GRAPH_API_VERSION=v21.0
